<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Shamim Ahmed – Education Graduate &amp; Aspiring NGO Professional</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;800&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#F4F7FA;--surface:#FFFFFF;--ink:#12203A;--muted:#55627A;--line:#D9E0EA;--sun:#E8A33D;--teal:#1C7C7D;--arch:#CFE8E4;--navy:#12203A;
--head:"Bricolage Grotesque","Trebuchet MS",Arial,sans-serif;--body:"Public Sans","Segoe UI",Arial,sans-serif;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0E1729;--surface:#16233D;--ink:#EEF2F8;--muted:#A3AFC4;--line:#28375A;--teal:#5CC4C0}}
:root[data-theme="dark"]{--bg:#0E1729;--surface:#16233D;--ink:#EEF2F8;--muted:#A3AFC4;--line:#28375A;--teal:#5CC4C0}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 70px);scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.05rem/1.65 var(--body)}
a{color:inherit}
:focus-visible{outline:3px solid var(--sun);outline-offset:3px;border-radius:4px}
.wrap{max-width:1080px;margin:0 auto;padding:0 24px}
h1,h2,h3{font-family:var(--head);margin:0;letter-spacing:-.02em;line-height:1.1}
h2{font-size:clamp(1.9rem,4vw,2.6rem);font-weight:800;margin-bottom:32px}
h3{font-size:1.2rem;font-weight:600;letter-spacing:-.01em}
p{margin:0}

/* header */
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:10;background:var(--bg);border-bottom:1px solid var(--line)}
.top .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;height:60px}
.mark{font:800 1.15rem var(--head);text-decoration:none;letter-spacing:-.02em}
nav{display:flex;gap:22px;font-size:.95rem;font-weight:500}
nav a{text-decoration:none;color:var(--muted)}nav a:hover{color:var(--ink)}
.editbtn{font:600 .9rem var(--body);border:2px solid var(--ink);background:transparent;color:var(--ink);border-radius:999px;padding:6px 16px;cursor:pointer}
.editbtn:hover{background:var(--ink);color:var(--bg)}
body.editing .editbtn{background:var(--sun);border-color:var(--sun);color:var(--navy)}
@media (max-width:720px){nav{display:none}}

/* edit mode */
.hint{display:none;background:var(--sun);color:var(--navy);font-size:.92rem;font-weight:500;text-align:center;padding:8px 16px}
body.editing .hint{display:block}
body.editing [data-e]{outline:2px dashed var(--teal);outline-offset:3px;border-radius:3px;cursor:text}
body.editing #photoWrap{cursor:pointer}
body.editing #photoWrap::after{content:"Click to change photo";position:absolute;inset:auto 0 0 0;background:rgba(18,32,58,.82);color:#fff;font-size:.85rem;text-align:center;padding:10px}
.hint button{font:inherit;font-weight:600;margin-left:12px;background:var(--navy);color:#fff;border:0;border-radius:999px;padding:3px 12px;cursor:pointer}

/* hero */
.hero{padding:64px 0 56px}
.hero .wrap{display:grid;grid-template-columns:1.15fr .85fr;gap:56px;align-items:center}
h1{font-size:clamp(3rem,8vw,5.8rem);font-weight:800;letter-spacing:-.035em;line-height:.95}
.role{font:600 1.25rem var(--head);color:var(--teal);margin:22px 0 14px}
.lead{max-width:34rem;color:var(--muted);font-size:1.12rem}
.btns{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}
.btn{display:inline-block;text-decoration:none;font-weight:600;font-size:.98rem;padding:12px 22px;border-radius:999px;border:2px solid var(--ink)}
.btn.main{background:var(--sun);border-color:var(--sun);color:var(--navy)}
.btn.main:hover{filter:brightness(.95)}
.btn:not(.main):hover{background:var(--ink);color:var(--bg)}
.pic{position:relative;justify-self:center;width:min(100%,360px)}
.pic::before{content:"";position:absolute;inset:18px -18px -18px 18px;border:3px solid var(--sun);border-radius:999px 999px 28px 28px}
#photoWrap{position:relative;aspect-ratio:426/560;border-radius:999px 999px 28px 28px;overflow:hidden;background:var(--arch)}
#photo{width:100%;height:100%;object-fit:cover;object-position:top;display:block;mix-blend-mode:multiply}
.tag{position:absolute;left:-14px;bottom:26px;z-index:2;background:var(--navy);color:#fff;font-weight:500;font-size:.9rem;line-height:1.35;padding:12px 16px;border-radius:14px;max-width:210px}
@media (max-width:800px){.hero .wrap{grid-template-columns:1fr;gap:44px}.pic{order:-1;width:min(78%,300px)}.hero{padding-top:36px}}

/* facts */
.facts{border-block:1px solid var(--line);background:var(--surface)}
.facts .wrap{display:grid;grid-template-columns:repeat(3,1fr)}
.fact{padding:26px 24px 26px 0}
.fact+.fact{padding-left:24px;border-left:1px solid var(--line)}
.fact b{display:block;font:800 2rem var(--head);letter-spacing:-.02em}
.fact span{color:var(--muted);font-size:.95rem}
@media (max-width:720px){.facts .wrap{grid-template-columns:1fr}.fact,.fact+.fact{padding:18px 0;border-left:0}.fact+.fact{border-top:1px solid var(--line)}}

section{padding:84px 0 0}
.about{display:grid;grid-template-columns:1.2fr .8fr;gap:56px}
.about p+p{margin-top:16px}
.about p{max-width:38rem}
.look h3{margin-bottom:14px}
.chips{display:flex;flex-wrap:wrap;gap:10px;padding:0;margin:0 0 22px;list-style:none}
.chips li{background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:6px 16px;font-weight:500;font-size:.95rem}
@media (max-width:800px){.about{grid-template-columns:1fr;gap:36px}}

/* timeline */
.tl{list-style:none;margin:0 0 0 8px;padding:0 0 0 34px;border-left:2px solid var(--line)}
.tl li{position:relative;padding-bottom:36px}
.tl li:last-child{padding-bottom:0}
.tl li::before{content:"";position:absolute;left:-43px;top:6px;width:16px;height:16px;border-radius:50%;background:var(--bg);border:4px solid var(--sun)}
.tl .yr{font-weight:600;color:var(--teal);font-size:.95rem}
.tl h3{margin:2px 0 4px}
.tl p{color:var(--muted)}
.tl .res{display:inline-block;margin-top:8px;font-weight:600;font-size:.9rem;background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:2px 10px}

/* skills */
.skills{display:grid;grid-template-columns:1.2fr .8fr;gap:56px}
.srow{padding:22px 0;border-top:1px solid var(--line)}
.srow:last-child{border-bottom:1px solid var(--line)}
.srow p{color:var(--muted);margin-top:6px}
.lang{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:28px}
.lang h3{margin-bottom:18px}
.lrow{display:grid;grid-template-columns:76px 1fr auto;gap:14px;align-items:center;padding:8px 0}
.seg{display:flex;gap:5px}.seg i{height:8px;flex:1;border-radius:4px;background:var(--line)}
.seg i.on{background:var(--teal)}
.lrow em{font-style:normal;font-size:.9rem;color:var(--muted);min-width:56px;text-align:right}
.lang .cap{color:var(--muted);font-size:.9rem;margin-top:14px}
@media (max-width:800px){.skills{grid-template-columns:1fr;gap:36px}}

/* reference + contact */
.ref{padding:26px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-top:56px}
.ref p{color:var(--muted)}.ref h3{margin-bottom:2px}
.contact{margin:84px 0 0;background:var(--navy);color:#fff;padding:72px 0}
.contact .wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center}
.contact h2{margin-bottom:14px}
.contact p{color:#B9C4D9;max-width:30rem}
.clist{display:grid;gap:14px;font-weight:500}
.clist div{display:grid;grid-template-columns:82px 1fr;gap:10px;padding-bottom:14px;border-bottom:1px solid rgba(255,255,255,.18)}
.clist small{color:#B9C4D9;font-size:.9rem;font-weight:400}
.clist a{word-break:break-all}
footer{padding:24px 0;color:var(--muted);font-size:.9rem}
@media (max-width:800px){.contact .wrap{grid-template-columns:1fr;gap:32px}}
</style>
</head>
<body>
