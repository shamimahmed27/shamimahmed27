<script>
(function(){
var KEY="shamim-portfolio-v1",els=[].slice.call(document.querySelectorAll("[data-e]")),photo=document.getElementById("photo");
function links(){[].forEach.call(document.querySelectorAll("[data-scheme]"),function(a){a.setAttribute("href",a.getAttribute("data-scheme")+a.textContent.trim())})}
function save(){try{var o={};els.forEach(function(e,i){o[i]=e.innerHTML});localStorage.setItem(KEY,JSON.stringify(o))}catch(e){}links()}
try{var s=JSON.parse(localStorage.getItem(KEY)||"null");if(s)els.forEach(function(e,i){if(s[i]!=null)e.innerHTML=s[i]});var p=localStorage.getItem(KEY+"-photo");if(p)photo.src=p}catch(e){}
links();
var btn=document.getElementById("editBtn");
btn.addEventListener("click",function(){var on=document.body.classList.toggle("editing");els.forEach(function(e){e.contentEditable=on?"true":"false"});btn.textContent=on?"Done editing":"Edit page";if(!on)save()});
els.forEach(function(e){e.addEventListener("input",save)});
document.getElementById("resetBtn").addEventListener("click",function(){if(confirm("Reset the page to the original text and photo?")){try{localStorage.removeItem(KEY);localStorage.removeItem(KEY+"-photo")}catch(e){}location.reload()}});
var inp=document.createElement("input");inp.type="file";inp.accept="image/*";
document.getElementById("photoWrap").addEventListener("click",function(){if(document.body.classList.contains("editing"))inp.click()});
inp.addEventListener("change",function(){var f=inp.files[0];if(!f)return;var r=new FileReader();r.onload=function(){photo.src=r.result;try{localStorage.setItem(KEY+"-photo",r.result)}catch(e){}};r.readAsDataURL(f)});
})();
</script>
